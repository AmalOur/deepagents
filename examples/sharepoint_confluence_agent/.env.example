# SharePoint & Confluence DeepAgent Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Confluence Configuration
# ============================================================================

# Confluence instance URL (without trailing slash)
CONFLUENCE_URL=https://your-confluence-instance.com

# Confluence Personal Access Token (Base64 encoded credentials)
# Format: base64(email:api_token) or as provided by your admin
# Example: echo -n 'your-email@example.com:your-api-token' | base64
CONFLUENCE_PERSONAL_TOKEN=your-base64-encoded-token-here

# ============================================================================
# SharePoint Configuration
# ============================================================================

# SharePoint site URL (e.g., https://yourtenant.sharepoint.com/sites/yoursite)
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/yoursite

# Azure AD Application (Client) ID
# To get these credentials:
# 1. Go to Azure Portal (https://portal.azure.com)
# 2. Navigate to Azure Active Directory > App registrations
# 3. Create a new registration or use existing one
# 4. Copy the Application (client) ID
SHAREPOINT_CLIENT_ID=your-client-id-here

# Azure AD Application Client Secret
# 1. In your app registration, go to Certificates & secrets
# 2. Create a new client secret
# 3. Copy the secret VALUE (not the ID)
SHAREPOINT_CLIENT_SECRET=your-client-secret-here

# Azure AD Tenant (Directory) ID
# 1. In Azure AD overview page, copy the Directory (tenant) ID
SHAREPOINT_TENANT_ID=your-tenant-id-here

# ============================================================================
# Custom LLM Configuration (Qwen/QVQ-72B-Preview)
# ============================================================================

# Model name (do not hardcode in code)
LLM_MODEL_NAME=Qwen/QVQ-72B-Preview

# Model API base URL (without /chat/completions, just the base with /v1)
LLM_API_BASE=https://your-model-api-endpoint.com/v1

# API Key for authentication
LLM_API_KEY=your-api-key-here

# ============================================================================
# Optional Configuration
# ============================================================================

# Enable/disable human-in-the-loop for destructive operations
# Set to 'false' to disable approval prompts (NOT RECOMMENDED)
ENABLE_HITL=true

# Log file for HITL approvals (for audit purposes)
HITL_LOG_FILE=hitl_approvals.log

# Maximum file size for document parsing (in MB)
MAX_DOCUMENT_SIZE_MB=50

# Default search result limit
DEFAULT_SEARCH_LIMIT=10

# ============================================================================
# Notes
# ============================================================================

# SharePoint Permissions Required:
# - Sites.Read.All or Sites.ReadWrite.All
# - Files.Read.All or Files.ReadWrite.All
# - User.Read (to access user information)
#
# Grant these permissions in Azure AD:
# 1. Go to your app registration
# 2. Navigate to API permissions
# 3. Add permissions > Microsoft Graph > Application permissions
# 4. Select the required permissions
# 5. Grant admin consent
#
# Confluence Permissions:
# - The personal token must have appropriate permissions for the spaces
#   you want to access (read, write, delete as needed)
#
# LLM Configuration:
# - The Qwen model is OpenAI-compatible
# - Supports multimodal input (text + images)
# - Default context window: check model documentation
